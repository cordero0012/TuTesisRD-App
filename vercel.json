{
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "tutesisrd.online"
                }
            ],
            "destination": "https://www.tutesisrd.online/$1",
            "permanent": true
        },
        {
            "comment": "Plantilla Bootstrap de terceros retirada en cc453d4. Sin esta regla, el rewrite comodín de más abajo devolvería 200 con el <head> de la portada para sus 17 URLs: un soft 404 que además declara la home como canónica de cada una.",
            "source": "/blog/devblog-v1.1/:path*",
            "destination": "/blog",
            "permanent": true
        },
        {
            "source": "/blog/blog-4",
            "destination": "/blog/metodologia-de-tesis-como-elegir",
            "permanent": true
        },
        {
            "source": "/blog/blog-5",
            "destination": "/blog/planteamiento-del-problema-tesis",
            "permanent": true
        },
        {
            "source": "/blog/blog-6",
            "destination": "/blog/marco-teorico-sin-plagio",
            "permanent": true
        },
        {
            "source": "/blog/blog-7",
            "destination": "/blog/disenar-encuestas-para-tesis",
            "permanent": true
        },
        {
            "source": "/blog/blog-8",
            "destination": "/blog/resultados-vs-discusion-tesis",
            "permanent": true
        },
        {
            "source": "/blog/blog-9",
            "destination": "/blog/como-defender-tu-tesis",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ]
}
