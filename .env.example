VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=123456789012345
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_KEY

# Server-side only (api/meta-capi.ts) — never prefix with VITE_, that exposes
# it to the browser bundle. Set these in Vercel's dashboard, not in a
# committed file: this repo is public.
META_PIXEL_ID=123456789012345
META_CAPI_ACCESS_TOKEN=YOUR_SYSTEM_USER_ACCESS_TOKEN
# Optional: paste the code from Events Manager > Test Events while verifying,
# then remove it — leaving it set marks real events as test traffic.
META_CAPI_TEST_EVENT_CODE=

# Server-side only (api/meta-ads-admin.ts) — a one-off create-only admin tool
# for Meta campaign/ad set/ad creation. Pick any long random string yourself;
# it just has to match what you send in the x-admin-secret header.
ADMIN_TOOL_SECRET=
