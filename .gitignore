.agent/

# MCP server config — contains API credentials (Google Ads developer token).
# Never commit. Use .mcp.json.example as the template.
.mcp.json

# Claude Code local settings — machine-specific, may capture credentials
# in allowed-command entries. Never commit.
.claude/settings.local.json

# Knowledge graph output — build artifact. Rebuild with `graphify update .`
graphify-out/
src/graphify-out/

# Lighthouse report output and the vendored skills checkout. Excluded so they do
# not flood the knowledge graph (they were 94% of its nodes).
.unlighthouse/
temp_skills_repo/

# Audit and advertising working files. The repository is PUBLIC: these describe
# open vulnerabilities and ad-account data. Keep them local.
audit-tu-tesis-rd/
ads-tu-tesis-rd/

# Lead scraper — carries a plaintext API token and scraped personal data.
scripts/scrapers/

# Agent tooling config — hardcodes absolute Windows paths to a local binary
# (C:\users\miang\...), so committing it breaks every other machine and CI.
# The rule above (!*.json) un-ignores these, hence the explicit entries.
.claude/settings.json
.codex/hooks.json

# Agent run artifacts: screenshot evidence (13 MB of PNGs), scratch plans and
# per-run progress state. The repository is PUBLIC and git keeps binaries in
# history forever — these are local working files, not deliverables.
.omx/screenshots/
.omx/plans/
.omx/state/landing-guide/
.omx/state/landing-motion/
